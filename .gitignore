# ============================================================
# AI-Chat 项目 .gitignore
# 说明：上传 GitHub 前请务必确认下方「敏感数据」部分已生效，
#       且 git 历史中从未包含这些文件（若已提交过需重写历史）。
# ============================================================

# ============================================================
# 🔴 敏感数据（最高优先级，严禁提交）
#   包含真实 API Key、用户密码哈希、长期记忆与对话内容
# ============================================================
# 配置文件（含明文 API Key）
config.yaml
config.yaml.bak
config.json
config.cfg
data/config.yaml
data/config.yaml.bak

# 密钥文件
data/.secret_key
**/password.hash
**/test_password.hash

# 数据库（含用户密码哈希、长期记忆、会话记录）
data/chat.db
data/chat.db-shm
data/chat.db-wal
data/chat.db-restored
data/chat.db.restored

# 用户数据与运行时 JSON（含账号、警报、挂载配置）
data/*.json
data/alerts/history.json

# 用户数据目录与备份（含账号、会话、记忆、上传、备份、恢复数据）
data/backups/
data/conversations/
data/json_backup/
data/recovery_/
data/recovery_*/
data/uploads/
data/traces/

# 挂载文件系统临时文件（.fuse_hidden*）
data/.fuse_hidden*

# ============================================================
# 🟡 运行时数据与日志（不应提交，含访客 IP、请求信息）
# ============================================================
logs/
*.log
botpy.log*

# ============================================================
# 🟢 Python 缓存与构建产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# 虚拟环境
venv/
.venv/
python3.11/
env/
ENV/
env.bak/
venv.bak/

# 构建 / 分发产物
dist/
build/
*.egg-info/
*.egg
*.whl
.eggs/

# ============================================================
# 🟢 开发工具 / IDE / 系统文件
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
# 🟢 评估 / 测试临时文件
# ============================================================
eval/workspace_tasks/
eval/reports/
eval/.tmp/
test-workflow-new.yaml
**/test-workflow-new.yaml

# ============================================================
# 🟢 其他
# ============================================================
.chatgpt_cache.json
Dockerfile.dev
/web/
uv.lock
data/db
data/frpc/

# 环境变量文件（API Key 等敏感信息，严禁提交）
.env
.env.*
!.env.example
